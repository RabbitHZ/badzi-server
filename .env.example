# 이 파일을 복사해서 .env 를 만들고 실제 값을 채우세요:
#   cp .env.example .env
# 강력한 비밀번호/키 생성 예시:
#   openssl rand -base64 36 | tr -d '/+=' | head -c 40

# Redis
REDIS_PASSWORD=change-me-to-a-strong-random-password

# PostgreSQL
DB_NAME=badzi
DB_USER=badzi
DB_PASSWORD=change-me-to-a-strong-random-password

# JWT (최소 32자 이상 랜덤 문자열)
APP_JWT_SECRET=change-me-to-a-strong-random-secret-min-32-chars
APP_JWT_ACCESS_EXPIRY=3600
APP_JWT_REFRESH_EXPIRY=604800

# PII 암호화 키 (AES-256-GCM: base64 인코딩된 32바이트)
# 생성: openssl rand -base64 32
APP_ENCRYPTION_KEY=change-me-base64-encoded-32-bytes-aes-key=
# SHA-256 blind index salt (임의 문자열)
APP_HASH_SALT=change-me-to-a-random-hash-salt

# 서버 기본 URL (Groble 진입/이동 페이지 URL 조립에 사용)
APP_BASE_URL=http://localhost:8080

# OAuth2 — GitHub
GITHUB_CLIENT_ID=your-github-oauth-app-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret

# OAuth2 — Google
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# 그로블 웹훅 서명 검증 시크릿
GROBLE_WEBHOOK_SECRET=change-me-after-groble-webhook-guide
